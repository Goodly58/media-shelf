    },
    {
      "src": "assets/icon-mono.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "monochrome"
    }
  ],
  "shortcuts": [
    {
      "name": "Games",
      "short_name": "Games",
