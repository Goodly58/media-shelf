  "description": "Browse PC games ranked by Metacritic and IGN, books ranked by rating. Fast, filterable, no sign-up.",
  "lang": "en",
  "dir": "ltr",
  "start_url": ".",
  "scope": ".",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "any",
  "background_color": "#080a0f",
